{
 "uid": "agentshield",
 "title": "AgentShield",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Tool calls",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(round(sum(increase(agentshield_tool_calls_total[$__range])))) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Blocked",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(round(sum(increase(agentshield_tool_calls_total{decision=\"deny\"}[$__range])))) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 2
  },
  {
   "type": "stat",
   "title": "Injections caught",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(round(sum(increase(agentshield_injections_total[$__range])))) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 3
  },
  {
   "type": "stat",
   "title": "Anomaly alerts",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(round(sum(increase(agentshield_alerts_total[$__range])))) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 4
  },
  {
   "type": "stat",
   "title": "LLM spend",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 4,
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(increase(agentshield_llm_cost_usd_total[$__range]))) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 5
  },
  {
   "type": "stat",
   "title": "Cache hit rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "fixed",
      "fixedColor": "purple"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "purple",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(increase(agentshield_llm_calls_total{cache_hit=\"True\"}[$__range])) / sum(increase(agentshield_llm_calls_total[$__range]))) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Tool calls by decision (per second)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 12
     }
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (decision) (rate(agentshield_tool_calls_total[1m]))",
     "legendFormat": "{{decision}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Gateway overhead per tool call",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 12
     }
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(agentshield_overhead_seconds_bucket[5m])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(agentshield_overhead_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "LLM calls by tier (per second)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 12
     }
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tier) (rate(agentshield_llm_calls_total[5m]))",
     "legendFormat": "{{tier}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "LLM spend (cumulative)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "fillOpacity": 12
     }
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(agentshield_llm_cost_usd_total)",
     "legendFormat": "total",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 10
  },
  {
   "type": "timeseries",
   "title": "Approvals by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 12
     }
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (increase(agentshield_approvals_total[5m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 11
  },
  {
   "type": "timeseries",
   "title": "Injections and alerts",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 12
     }
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(agentshield_injections_total[5m]))",
     "legendFormat": "injections",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (kind) (increase(agentshield_alerts_total[5m]))",
     "legendFormat": "alert: {{kind}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 12
  }
 ],
 "tags": [
  "agentshield"
 ]
}